        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        if dist > ESP_MaxDistance then
            data.box.Visible = false
            data.healthBar.Visible = false
            data.healthBg.Visible = false
            data.healthBorder.Visible = false
            data.healthText.Visible = false
            data.distText.Visible = false
            for _, line in ipairs(data.skeleton) do
                line.Visible = false
            end
            return
        end

        local headPart = char:FindFirstChild("Head")
        local headPos = (ESP_Skeleton and headPart) and headPart.Position or (root.Position + Vector3.new(0, 2, 0))
        local screenHead, onScreenHead = WorldToScreen(headPos)
        local screenFoot, onScreenFoot = WorldToScreen(root.Position - Vector3.new(0, 3, 0))
        if not onScreenHead and not onScreenFoot then
            data.box.Visible = false
            data.healthBar.Visible = false
            data.healthBg.Visible = false
            data.healthBorder.Visible = false
            data.healthText.Visible = false
            data.distText.Visible = false
            for _, line in ipairs(data.skeleton) do
                line.Visible = false
            end
            return
        end

        local height = screenFoot.Y - screenHead.Y
        local width = height * 0.6
        local boxPos = Vector2.new(screenHead.X - width / 2, screenHead.Y)

        if ESP_Box then
            data.box.Size = Vector2.new(width, height)
            data.box.Position = boxPos
            data.box.Visible = true
        else
            data.box.Visible = false
        end

        if ESP_Health then
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            local barX = screenHead.X - 50 / 2
            local barY = screenHead.Y - 10
            data.healthBg.Size = Vector2.new(50, 5)
            data.healthBg.Position = Vector2.new(barX, barY)
            data.healthBg.Visible = true
            data.healthBorder.Size = Vector2.new(50, 5)
            data.healthBorder.Position = Vector2.new(barX, barY)
            data.healthBorder.Visible = true
            data.healthBar.Size = Vector2.new(50 * healthPercent, 5)
            data.healthBar.Position = Vector2.new(barX, barY)
            if healthPercent >= 0.8 then
                data.healthBar.Color = Color3.new(0, 1, 0)
            elseif healthPercent >= 0.5 then
                data.healthBar.Color = Color3.new(1, 1, 0)
            elseif healthPercent >= 0.2 then
                data.healthBar.Color = Color3.new(1, 0.5, 0)
            else
                data.healthBar.Color = Color3.new(1, 0, 0)
            end
            data.healthBar.Visible = true
            data.healthText.Position = Vector2.new(screenHead.X - 50 / 2 + 50 + 5, screenHead.Y - 10 - 5)
            data.healthText.Text = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
            data.healthText.Visible = true
        else
            data.healthBar.Visible = false
            data.healthBg.Visible = false
            data.healthBorder.Visible = false
            data.healthText.Visible = false
        end

        if ESP_Distance then
            data.distText.Position = Vector2.new(screenHead.X, screenHead.Y + 10)
            data.distText.Text = math.floor(dist) .. "m"
            data.distText.Visible = true
        else
            data.distText.Visible = false
        end

        if ESP_Skeleton then
            local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            if headPart and torso then
                local headScreen, onHead = WorldToScreen(headPart.Position)
                local torsoScreen, onTorso = WorldToScreen(torso.Position)
                if onHead and onTorso then
                    data.skeleton[1].From = headScreen
                    data.skeleton[1].To = torsoScreen
                    data.skeleton[1].Visible = true
                else
                    data.skeleton[1].Visible = false
                end

                local leftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
                local rightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
                local leftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
                local rightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")

                if leftArm then
                    local armScreen, onArm = WorldToScreen(leftArm.Position)
                    if onArm then
                        data.skeleton[2].From = torsoScreen
                        data.skeleton[2].To = armScreen
                        data.skeleton[2].Visible = true
                    else
                        data.skeleton[2].Visible = false
                    end
                end
                if rightArm then
                    local armScreen, onArm = WorldToScreen(rightArm.Position)
                    if onArm then
                        data.skeleton[3].From = torsoScreen
                        data.skeleton[3].To = armScreen
                        data.skeleton[3].Visible = true
                    else
                        data.skeleton[3].Visible = false
                    end
                end
                if leftLeg then
