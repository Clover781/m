    local function WorldToScreen(point)
        if not Camera then return Vector2.new(0, 0), false end
        local vec, onScreen = Camera:WorldToViewportPoint(point)
        return Vector2.new(vec.X, vec.Y), onScreen, vec.Z
    end

    local function CreateESPForPlayer(plr)
        if ESP_Drawings[plr] then return end
        local box = Drawing.new("Square")
        box.Visible = false
        box.Color = Color3.fromRGB(255, 255, 255)
        box.Thickness = 1
        box.Filled = false
        local skeleton = {}
        for i = 1, 15 do
            local line = Drawing.new("Line")
            line.Visible = false
            line.Color = Color3.fromRGB(0, 255, 255)
            line.Thickness = 2
            skeleton[i] = line
        end
        local healthBar = Drawing.new("Square")
        healthBar.Visible = false
        healthBar.Color = Color3.fromRGB(0, 255, 0)
        healthBar.Thickness = 1
        healthBar.Filled = true
        local healthBg = Drawing.new("Square")
        healthBg.Visible = false
        healthBg.Color = Color3.new(0, 0, 0)
        healthBg.Transparency = 0.5
        healthBg.Thickness = 1
        healthBg.Filled = true
        local healthBorder = Drawing.new("Square")
        healthBorder.Visible = false
        healthBorder.Color = Color3.new(1, 1, 1)
        healthBorder.Thickness = 1
        healthBorder.Filled = false
        local healthText = Drawing.new("Text")
        healthText.Visible = false
        healthText.Color = Color3.fromRGB(255, 255, 255)
        healthText.Size = 14
        healthText.Font = Drawing.Fonts.Monospace
        healthText.Outline = true
        healthText.OutlineColor = Color3.new(0, 0, 0)
        local distText = Drawing.new("Text")
        distText.Visible = false
        distText.Color = Color3.fromRGB(255, 255, 0)
        distText.Size = 14
        distText.Font = Drawing.Fonts.Monospace
        distText.Outline = true
        distText.OutlineColor = Color3.new(0, 0, 0)

        ESP_Drawings[plr] = {
            box = box,
            skeleton = skeleton,
            healthBar = healthBar,
            healthBg = healthBg,
            healthBorder = healthBorder,
            healthText = healthText,
            distText = distText
        }
    end

    local function RemoveESPForPlayer(plr)
        local data = ESP_Drawings[plr]
        if data then
            pcall(function() data.box:Remove() end)
            pcall(function() data.healthBar:Remove() end)
            pcall(function() data.healthBg:Remove() end)
            pcall(function() data.healthBorder:Remove() end)
            pcall(function() data.healthText:Remove() end)
            pcall(function() data.distText:Remove() end)
            for _, line in ipairs(data.skeleton) do
                pcall(function() line:Remove() end)
            end
            ESP_Drawings[plr] = nil
        end
    end

    local function UpdatePlayerESP(plr)
        local data = ESP_Drawings[plr]
        if not data then return end
        if not ESP_Enabled then
            data.box.Visible = false
            data.healthBar.Visible = false
            data.healthBg.Visible = false
            data.healthBorder.Visible = false
            data.healthText.Visible = false
            data.distText.Visible = false
            for _, line in ipairs(data.skeleton) do
                line.Visible = false
            end
            return
        end

        local char = plr.Character
        if not char or not char.Parent then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root or not humanoid or humanoid.Health <= 0 then
            data.box.Visible = false
            data.healthBar.Visible = false
            data.healthBg.Visible = false
            data.healthBorder.Visible = false
            data.healthText.Visible = false
            data.distText.Visible = false
            for _, line in ipairs(data.skeleton) do
                line.Visible = false
            end
            return
        end

        if ESP_TeamCheck and plr.Team == LocalPlayer.Team then
            data.box.Visible = false
            data.healthBar.Visible = false
            data.healthBg.Visible = false
            data.healthBorder.Visible = false
            data.healthText.Visible = false
            data.distText.Visible = false
            for _, line in ipairs(data.skeleton) do
                line.Visible = false
            end
            return
        end

        local dist = (root.Position - Camera.CFrame.Position).Magnitude
        if dist > ESP_MaxDistance then
            data.box.Visible = false
            data.healthBar.Visible = false
            data.healthBg.Visible = false
            data.healthBorder.Visible = false
            data.healthText.Visible = false
            data.distText.Visible = false
            for _, line in ipairs(data.skeleton) do
                line.Visible = false
            end
            return
        end

        local headPart = char:FindFirstChild("Head")
        local headPos = (ESP_Skeleton and headPart) and headPart.Position or (root.Position + Vector3.new(0, 2, 0))
        local screenHead, onScreenHead = WorldToScreen(headPos)
        local screenFoot, onScreenFoot = WorldToScreen(root.Position - Vector3.new(0, 3, 0))
        if not onScreenHead and not onScreenFoot then
            data.box.Visible = false
            data.healthBar.Visible = false
            data.healthBg.Visible = false
            data.healthBorder.Visible = false
            data.healthText.Visible = false
            data.distText.Visible = false
            for _, line in ipairs(data.skeleton) do
                line.Visible = false
            end
            return
        end

        local height = screenFoot.Y - screenHead.Y
        local width = height * 0.6
        local boxPos = Vector2.new(screenHead.X - width / 2, screenHead.Y)

        if ESP_Box then
            data.box.Size = Vector2.new(width, height)
            data.box.Position = boxPos
            data.box.Visible = true
        else
            data.box.Visible = false
        end

        if ESP_Health then
            local healthPercent = humanoid.Health / humanoid.MaxHealth
            local barX = screenHead.X - 50 / 2
            local barY = screenHead.Y - 10
            data.healthBg.Size = Vector2.new(50, 5)
            data.healthBg.Position = Vector2.new(barX, barY)
            data.healthBg.Visible = true
            data.healthBorder.Size = Vector2.new(50, 5)
            data.healthBorder.Position = Vector2.new(barX, barY)
            data.healthBorder.Visible = true
            data.healthBar.Size = Vector2.new(50 * healthPercent, 5)
            data.healthBar.Position = Vector2.new(barX, barY)
            if healthPercent >= 0.8 then
                data.healthBar.Color = Color3.new(0, 1, 0)
            elseif healthPercent >= 0.5 then
                data.healthBar.Color = Color3.new(1, 1, 0)
            elseif healthPercent >= 0.2 then
                data.healthBar.Color = Color3.new(1, 0.5, 0)
            else
                data.healthBar.Color = Color3.new(1, 0, 0)
            end
            data.healthBar.Visible = true
            data.healthText.Position = Vector2.new(screenHead.X - 50 / 2 + 50 + 5, screenHead.Y - 10 - 5)
            data.healthText.Text = math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
            data.healthText.Visible = true
        else
            data.healthBar.Visible = false
            data.healthBg.Visible = false
            data.healthBorder.Visible = false
            data.healthText.Visible = false
        end

        if ESP_Distance then
            data.distText.Position = Vector2.new(screenHead.X, screenHead.Y + 10)
            data.distText.Text = math.floor(dist) .. "m"
            data.distText.Visible = true
        else
            data.distText.Visible = false
        end

        if ESP_Skeleton then
            local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            if headPart and torso then
                local headScreen, onHead = WorldToScreen(headPart.Position)
                local torsoScreen, onTorso = WorldToScreen(torso.Position)
                if onHead and onTorso then
                    data.skeleton[1].From = headScreen
                    data.skeleton[1].To = torsoScreen
                    data.skeleton[1].Visible = true
                else
                    data.skeleton[1].Visible = false
                end

                local leftArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
                local rightArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
                local leftLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
                local rightLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Arm")

                if leftArm then
                    local armScreen, onArm = WorldToScreen(leftArm.Position)
                    if onArm then
                        data.skeleton[2].From = torsoScreen
                        data.skeleton[2].To = armScreen
                        data.skeleton[2].Visible = true
                    else
                        data.skeleton[2].Visible = false
                    end
                end
                if rightArm then
                    local armScreen, onArm = WorldToScreen(rightArm.Position)
                    if onArm then
                        data.skeleton[3].From = torsoScreen
                        data.skeleton[3].To = armScreen
                        data.skeleton[3].Visible = true
                    else
                        data.skeleton[3].Visible = false
                    end
                end
                if leftLeg then
                    local legScreen, onLeg = WorldToScreen(leftLeg.Position)
                    if onLeg then
                        data.skeleton[4].From = torsoScreen
                        data.skeleton[4].To = legScreen
                        data.skeleton[4].Visible = true
                    else
                        data.skeleton[4].Visible = false
                    end
                end
                if rightLeg then
                    local legScreen, onLeg = WorldToScreen(rightLeg.Position)
                    if onLeg then
                        data.skeleton[5].From = torsoScreen
                        data.skeleton[5].To = legScreen
                        data.skeleton[5].Visible = true
                    else
                        data.skeleton[5].Visible = false
                    end
                end
            end
            for i = 6, 15 do
                data.skeleton[i].Visible = false
            end
        else
            for _, line in ipairs(data.skeleton) do
                line.Visible = false
            end
        end
    end

    local function CreateNPCESP(model)
        if NPC_Drawings[model] then return end
        if not ESP_NPC or not ESP_Enabled then return end
        local highlight = Instance.new("Highlight")
        highlight.FillColor = Color3.fromRGB(255, 100, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
        highlight.FillTransparency = 0.5
        highlight.Parent = model
        local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
        local billboard = nil
        if head then
            billboard = Instance.new("BillboardGui")
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 200, 0, 40)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true
            billboard.Parent = head
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.Text = model.Name
            label.TextColor3 = Color3.fromRGB(255, 255, 0)
            label.TextScaled = true
            label.Font = Enum.Font.GothamBold
            label.Parent = billboard
        end
        NPC_Drawings[model] = { hl = highlight, bb = billboard }
    end

    local function RemoveNPCESP(model)
        local data = NPC_Drawings[model]
        if data then
            if data.hl then pcall(function() data.hl:Destroy() end) end
            if data.bb then pcall(function() data.bb:Destroy() end) end
            NPC_Drawings[model] = nil
        end
    end

    local function UpdateNPCESP()
        if not ESP_NPC or not ESP_Enabled then
            for model in pairs(NPC_Drawings) do
                RemoveNPCESP(model)
            end
            return
        end
        local npcKeywords = { "NPC", "Monster", "Enemy", "Animal", "Zombie", "Ghost", "SCP", "Figure", "Rush", "Seek", "Cultist", "Wolf", "Deer", "Bear" }
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(obj) then
                local isNPC = false
                for _, kw in ipairs(npcKeywords) do
                    if obj.Name:find(kw) then
                        isNPC = true
                        break
                    end
                end
                if isNPC then
                    if not NPC_Drawings[obj] then
                        CreateNPCESP(obj)
                    end
                else
                    if NPC_Drawings[obj] then
                        RemoveNPCESP(obj)
                    end
                end
            end
        end
        for model in pairs(NPC_Drawings) do
            if not model.Parent then
                RemoveNPCESP(model)
            end
        end
    end

    local renderSteppedConn = nil
    local function StartESP()
        if renderSteppedConn then renderSteppedConn:Disconnect() end
        renderSteppedConn = RunService.RenderStepped:Connect(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    if not ESP_Drawings[plr] then
                        CreateESPForPlayer(plr)
                    end
                    UpdatePlayerESP(plr)
                end
            end
            UpdateNPCESP()
        end)
    end

    local function StopESP()
        if renderSteppedConn then
            renderSteppedConn:Disconnect()
            renderSteppedConn = nil
        end
        for plr in pairs(ESP_Drawings) do
            RemoveESPForPlayer(plr)
        end
        for model in pairs(NPC_Drawings) do
            RemoveNPCESP(model)
        end
    end

