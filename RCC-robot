    local function WorldToScreen(point)
        if not Camera then return Vector2.new(0, 0), false end
        local vec, onScreen = Camera:WorldToViewportPoint(point)
        return Vector2.new(vec.X, vec.Y), onScreen, vec.Z
    end

    local function CreateESPForPlayer(plr)
        if ESP_Drawings[plr] then return end
        local box = Drawing.new("Square")
        box.Visible = false
        box.Color = Color3.fromRGB(255, 255, 255)
        box.Thickness = 1
        box.Filled = false
        
        local skeleton = {}
        for i = 1, 15 do
            local line = Drawing.new("Line")
            line.Visible = false
            line.Color = Color3.fromRGB(0, 255, 255)
            line.Thickness = 2
            skeleton[i] = line
        end
        
        local healthBar = Drawing.new("Square")
        healthBar.Visible = false
        healthBar.Color = Color3.fromRGB(0, 255, 0)
        healthBar.Thickness = 1
        healthBar.Filled = true
        
        local healthBg = Drawing.new("Square")
        healthBg.Visible = false
        healthBg.Color = Color3.new(0, 0, 0)
        healthBg.Transparency = 0.5
        healthBg.Thickness = 1
        healthBg.Filled = true
        
        local healthBorder = Drawing.new("Square")
        healthBorder.Visible = false
        healthBorder.Color = Color3.new(1, 1, 1)
        healthBorder.Thickness = 1
        healthBorder.Filled = false
        
        local healthText = Drawing.new("Text")
        healthText.Visible = false
        healthText.Color = Color3.fromRGB(255, 255, 255)
        healthText.Size = 14
        healthText.Font = Drawing.Fonts.Monospace
        healthText.Outline = true
        healthText.OutlineColor = Color3.new(0, 0, 0)
        
