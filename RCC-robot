    local OriginalTransparencies = {}
    local function setInvisibility(enable)
        local character = LocalPlayer.Character
        if not character then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.Name ~= "HumanoidRootPart" then
                    if enable then
                        if not OriginalTransparencies[part] then OriginalTransparencies[part] = part.Transparency end
                        part.Transparency = 1
                    else
                        part.Transparency = OriginalTransparencies[part] or 0
                    end
                end
            elseif part:IsA("Decal") then
                if enable then
                    if not OriginalTransparencies[part] then OriginalTransparencies[part] = part.Transparency end
                    part.Transparency = 1
                else
                    part.Transparency = OriginalTransparencies[part] or 0
                end
            end
        end
        local head = character:FindFirstChild("Head")
        if head then
            for _, gui in ipairs(head:GetChildren()) do
                if gui:IsA("BillboardGui") then gui.Enabled = not enable end
            end
        end
    end

